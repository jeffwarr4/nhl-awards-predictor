# Python cruft
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Ignore pickle files, except the committed model artifacts (the exception must come after)
*.pkl
!Models/Artifacts/*.pkl

# Virtual environments
.venv/
venv/
env/
ENV/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Data outputs (we want these *generated* by the workflow)
Data/Raw/*.csv
Data/Processed/*.csv

# Logs
*.log

Assests/

